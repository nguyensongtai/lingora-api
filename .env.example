APP_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://lingora:lingora@localhost:5432/lingora?sslmode=disable

# Tối thiểu 32 byte. Sinh bằng: openssl rand -base64 48
JWT_SECRET=thay-bang-secret-that-dai-toi-thieu-32-byte

# Danh sách origin của frontend, phân tách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Vòng đời token. Mặc định 15m và 720h nếu không đặt.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Đăng nhập bằng Google. Tạo OAuth client kiểu "Web application" tại
# https://console.cloud.google.com/apis/credentials và thêm redirect URI
# http://localhost:3000/api/auth/google/callback (đổi tên miền khi lên production).
# Bỏ trống thì tính năng tắt và endpoint /auth/google trả 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kho đếm hạn mức đăng nhập. Bỏ trống thì đếm trong bộ nhớ của từng tiến trình,
# chỉ đúng khi chạy một instance. Production dùng Upstash.
REDIS_URL=redis://localhost:6379/0

# Database cho integration test của tầng repo. Bỏ trống thì những test đó tự bỏ
# qua. Trỏ vào database riêng nếu không muốn test chạy trên dữ liệu dev —
# chúng chạy trong transaction và luôn rollback, nhưng vẫn nên tách.
TEST_DATABASE_URL=postgres://lingora:lingora@localhost:5432/lingora?sslmode=disable
